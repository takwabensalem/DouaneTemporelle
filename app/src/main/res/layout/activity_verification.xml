
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="#DCE5EF">

    <!-- 1. صورة جواز السفر على اليسار -->
    <ImageView
        android:id="@+id/img_passeport_tb"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:src="@drawable/passeport"
        android:scaleType="centerCrop"
        android:contentDescription="Passeport temporel"
        android:background="#17365D" />

    <!-- 2. معلومات جواز السفر على اليمين -->
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:padding="14dp"
        android:background="#FFFDF5">

        <TextView
            android:id="@+id/txt_titre_verif_tb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PASSEPORT TEMPOREL"
            android:textColor="#17365D"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="10dp"
            android:background="#E8EEF5"
            android:layout_alignParentTop="true" />

        <TextView
            android:id="@+id/txt_nom_verif_tb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nom du voyageur"
            android:textColor="#202A35"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:background="#F0F3F6"
            android:layout_below="@id/txt_titre_verif_tb"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/txt_difference_tb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Âge temporel"
            android:textColor="#202A35"
            android:textSize="16sp"
            android:padding="8dp"
            android:layout_below="@id/txt_nom_verif_tb"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/txt_premier_tb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre premier"
            android:textColor="#202A35"
            android:textSize="16sp"
            android:padding="8dp"
            android:layout_below="@id/txt_difference_tb"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txt_motif_verif_tb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Motif du voyage"
            android:textColor="#202A35"
            android:textSize="16sp"
            android:padding="8dp"
            android:layout_below="@id/txt_premier_tb"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txt_decision_tb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Approbation interdite"
            android:textColor="#B71C1C"
            android:textSize="15sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:background="#FCE8E6"
            android:layout_below="@id/txt_motif_verif_tb"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btn_approuver_tb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Autoriser le voyage"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32"
            android:layout_below="@id/txt_decision_tb"
            android:layout_marginTop="14dp" />

        <Button
            android:id="@+id/btn_refuser_tb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rejeter la demande"
            android:textColor="#FFFFFF"
            android:backgroundTint="#B71C1C"
            android:layout_below="@id/btn_approuver_tb"
            android:layout_marginTop="8dp" />

    </RelativeLayout>

</LinearLayout>
